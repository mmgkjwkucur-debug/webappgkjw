rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserData() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function listHasRole(targetRole, roles) {
      return roles is list
        && roles.size() > 0
        && targetRole in roles;
    }

    function userHasRole(targetRole) {
      let data = currentUserData();
      return data != null
        && (
          data.role == targetRole
          || data.role == "admin"
          || listHasRole(targetRole, data.roles)
          || listHasRole("admin", data.roles)
        );
    }

    function isMultimediaAdmin() {
      return userHasRole("admin") || userHasRole("multi_media");
    }

    function isStaff() {
      return userHasRole("admin")
        || userHasRole("sekretariat")
        || userHasRole("bendahara")
        || userHasRole("phmj")
        || userHasRole("majelis")
        || userHasRole("multi_media");
    }

    function hasValidRoles(data) {
      return data.roles is list
        && data.roles.size() >= 1
        && data.roles.size() <= 6
        && data.roles.hasOnly(["admin", "sekretariat", "bendahara", "phmj", "majelis", "multi_media"])
        && data.role is string
        && data.role in data.roles
        && (!("menuAccess" in data) || (data.menuAccess is list && data.menuAccess.size() <= 50));
    }

    function isValidUser(data) {
      return data.keys().hasOnly(["nama", "email", "roles", "role", "menuAccess", "status", "createdAt", "updatedAt"])
        && data.keys().hasAll(["nama", "email", "roles", "role", "status", "createdAt", "updatedAt"])
        && data.nama is string
        && data.email is string
        && data.status in ["active", "inactive"]
        && data.createdAt is string
        && data.updatedAt is string
        && data.nama.size() >= 2
        && data.nama.size() <= 120
        && data.email.size() >= 5
        && data.email.size() <= 180
        && data.createdAt.size() <= 40
        && data.updatedAt.size() <= 40
        && hasValidRoles(data);
    }

    function isValidPost(data) {
      return data.keys().hasOnly(["judul", "ringkasan", "isi", "status", "tanggal", "authorRole"])
        && data.keys().hasAll(["judul", "ringkasan", "isi", "status", "tanggal", "authorRole"])
        && data.judul is string
        && data.ringkasan is string
        && data.isi is string
        && data.status in ["draft", "published"]
        && data.tanggal is string
        && data.authorRole is string
        && data.authorRole in ["admin", "sekretariat", "bendahara", "phmj", "majelis", "multi_media"]
        && data.judul.size() >= 3
        && data.judul.size() <= 120
        && data.ringkasan.size() <= 280
        && data.isi.size() <= 12000
        && data.tanggal.size() <= 40;
    }

    function isValidJadwalIbadah(data) {
      return data.keys().hasOnly(["tanggal", "waktu", "jenis", "tema", "bacaan", "pelayanFirman", "liturgos", "majelis", "pemusik", "multimedia", "isPublic"])
        && data.keys().hasAll(["tanggal", "waktu", "jenis", "tema", "bacaan", "pelayanFirman", "liturgos", "majelis", "pemusik", "multimedia"])
        && (!("isPublic" in data) || data.isPublic is bool)
        && data.tanggal is timestamp
        && data.waktu is string
        && data.jenis is string
        && data.tema is string
        && data.bacaan is string
        && data.pelayanFirman is string
        && data.liturgos is string
        && data.majelis is string
        && data.pemusik is string
        && data.multimedia is string;
    }

    function isValidRenungan(data) {
      return data.keys().hasOnly(["judul", "isi", "tanggal", "authorRole", "createdAt", "updatedAt"]) 
        && data.keys().hasAll(["judul", "isi", "tanggal", "authorRole", "createdAt", "updatedAt"]) 
        && data.judul is string
        && data.isi is string
        && data.tanggal is string
        && data.authorRole is string
        && data.authorRole in ["admin", "sekretariat", "bendahara", "phmj", "majelis", "multi_media"]
        && data.createdAt is string
        && data.updatedAt is string
        && data.judul.size() >= 3
        && data.judul.size() <= 200
        && data.isi.size() >= 3
        && data.isi.size() <= 12000
        && data.tanggal.size() <= 40
        && data.createdAt.size() <= 40
        && data.updatedAt.size() <= 40;
    }

    function isValidMutasi(data) {
      return data.keys().hasOnly(["jenis_mutasi", "jemaat_id", "jemaat_nama", "gereja_asal", "gereja_tujuan", "tanggal_atestasi", "tanggal_meninggal", "nomor_surat_atestasi", "tempat_dimakamkan", "keterangan", "createdAt", "updatedAt"])
        && data.keys().hasAll(["jenis_mutasi", "createdAt", "updatedAt"])
        && data.jenis_mutasi is string
        && data.jenis_mutasi in ["atestasi_masuk", "atestasi_keluar", "meninggal"]
        && data.createdAt is string
        && data.updatedAt is string
        && (!("jemaat_id" in data) || data.jemaat_id is string)
        && (!("jemaat_nama" in data) || data.jemaat_nama is string)
        && (!("gereja_asal" in data) || data.gereja_asal is string)
        && (!("gereja_tujuan" in data) || data.gereja_tujuan is string)
        && (!("tanggal_atestasi" in data) || data.tanggal_atestasi is string)
        && (!("tanggal_meninggal" in data) || data.tanggal_meninggal is string)
        && (!("nomor_surat_atestasi" in data) || data.nomor_surat_atestasi is string)
        && (!("tempat_dimakamkan" in data) || data.tempat_dimakamkan is string)
        && (!("keterangan" in data) || data.keterangan is string);
    }

    function isValidPenerimaanKas(data) {
      return data.keys().hasOnly(["tanggal", "nominal", "kategori_penerimaan", "jenis_ibadah", "keterangan", "nama_jemaat", "jenis", "doa_keterangan", "nama_donatur", "tujuan", "createdAt", "updatedAt"])
        && data.keys().hasAll(["tanggal", "nominal", "kategori_penerimaan", "createdAt", "updatedAt"])
        && data.tanggal is string
        && data.nominal is number
        && data.kategori_penerimaan is string
        && data.kategori_penerimaan in ["Persembahan Ibadah", "Persepuluhan & Syukur", "Sumbangan Khusus"]
        && data.createdAt is string
        && data.updatedAt is string
        && data.tanggal.size() <= 40
        && data.kategori_penerimaan.size() <= 60
        && data.createdAt.size() <= 40
        && data.updatedAt.size() <= 40
        && (!("jenis_ibadah" in data) || (data.jenis_ibadah is string && data.jenis_ibadah.size() <= 120))
        && (!("keterangan" in data) || (data.keterangan is string && data.keterangan.size() <= 800))
        && (!("nama_jemaat" in data) || (data.nama_jemaat is string && data.nama_jemaat.size() <= 120))
        && (!("jenis" in data) || (data.jenis is string && data.jenis.size() <= 120))
        && (!("doa_keterangan" in data) || (data.doa_keterangan is string && data.doa_keterangan.size() <= 800))
        && (!("nama_donatur" in data) || (data.nama_donatur is string && data.nama_donatur.size() <= 120))
        && (!("tujuan" in data) || (data.tujuan is string && data.tujuan.size() <= 160));
    }

    function isValidPengeluaranKas(data) {
      return data.keys().hasOnly(["tanggal", "kategori", "nomorNota", "keterangan", "nominal", "createdAt", "updatedAt"])
        && data.keys().hasAll(["tanggal", "kategori", "keterangan", "nominal", "createdAt", "updatedAt"])
        && data.tanggal is string
        && data.kategori is string
        && data.kategori in ["Operasional", "Honorarium/Gaji", "Kegiatan & Pelayanan", "Diakonia & Sosial", "Pembangunan & Pemeliharaan", "Lain-lain"]
        && data.nominal is number
        && data.createdAt is string
        && data.updatedAt is string
        && data.tanggal.size() <= 40
        && data.kategori.size() <= 60
        && data.createdAt.size() <= 40
        && data.updatedAt.size() <= 40
        && data.keterangan is string
        && data.keterangan.size() <= 800
        && (!("nomorNota" in data) || (data.nomorNota is string && data.nomorNota.size() <= 120));
    }

    function isValidPublicMenu(data) {
      return data.keys().hasOnly(["label", "slug", "parentId", "order", "status", "pageTitle", "pageSummary", "pageContent", "ctaLabel", "ctaUrl", "createdAt", "updatedAt", "authorRole"])
        && data.keys().hasAll(["label", "slug", "parentId", "order", "status", "pageTitle", "pageSummary", "pageContent", "ctaLabel", "ctaUrl", "createdAt", "updatedAt", "authorRole"])
        && data.label is string
        && data.slug is string
        && data.parentId is string
        && data.order is number
        && data.status in ["draft", "published"]
        && data.pageTitle is string
        && data.pageSummary is string
        && data.pageContent is string
        && data.ctaLabel is string
        && data.ctaUrl is string
        && data.createdAt is string
        && data.updatedAt is string
        && data.authorRole is string
        && data.authorRole in ["admin", "sekretariat", "bendahara", "phmj", "majelis", "multi_media"]
        && data.label.size() >= 2
        && data.label.size() <= 80
        && data.slug.size() >= 2
        && data.slug.size() <= 100
        && data.parentId.size() <= 120
        && data.order >= 0
        && data.order <= 999
        && data.pageTitle.size() >= 3
        && data.pageTitle.size() <= 140
        && data.pageSummary.size() >= 3
        && data.pageSummary.size() <= 320
        && data.pageContent.size() >= 3
        && data.pageContent.size() <= 12000
        && data.ctaLabel.size() <= 80
        && data.ctaUrl.size() <= 240
        && data.createdAt.size() <= 40
        && data.updatedAt.size() <= 40;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || userHasRole("admin"));
      allow list: if signedIn() && userHasRole("admin");
      allow create, update: if signedIn() && userHasRole("admin") && isValidUser(request.resource.data);
      allow delete: if signedIn() && userHasRole("admin");
    }

    match /posts/{postId} {
      allow read: if resource.data.status == "published" || isStaff();
      allow create, update: if isMultimediaAdmin() && isValidPost(request.resource.data);
      allow delete: if isMultimediaAdmin();
    }

    match /jadwal_ibadah/{scheduleId} {
      allow read: if resource.data.isPublic == true || isStaff();
      allow create, update: if isStaff() && isValidJadwalIbadah(request.resource.data);
      allow delete: if isStaff();
    }

    match /publicMenus/{menuId} {
      allow read: if resource.data.status == "published" || isStaff();
      allow create, update: if isMultimediaAdmin() && isValidPublicMenu(request.resource.data);
      allow delete: if isMultimediaAdmin();
    }

    match /renungan/{id} {
      allow read: if true;
      allow create, update: if isMultimediaAdmin() && isValidRenungan(request.resource.data);
      allow delete: if isMultimediaAdmin();
    }

    match /mutasi/{mutasiId} {
      allow get, list: if signedIn() && isStaff();
      allow create, update: if signedIn() && isStaff() && isValidMutasi(request.resource.data);
      allow delete: if signedIn() && userHasRole("admin");
    }

    match /absensi_ibadah/{entryId} {
      allow get, list: if signedIn() && isStaff();
      allow create: if signedIn() && isStaff();
      allow update, delete: if signedIn() && userHasRole("admin");
    }

    match /penerimaan_kas/{entryId} {
      allow get, list: if signedIn() && isStaff();
      allow create, update: if signedIn() && isStaff() && isValidPenerimaanKas(request.resource.data);
      allow delete: if signedIn() && userHasRole("admin");
    }

    match /pengeluaran_kas/{entryId} {
      allow get, list: if signedIn() && isStaff();
      allow create, update: if signedIn() && isStaff() && isValidPengeluaranKas(request.resource.data);
      allow delete: if signedIn() && userHasRole("admin");
    }

    match /data_induk/{memberId} {
      allow get, list: if signedIn() && isStaff();
      allow create, update: if signedIn() && isStaff();
      allow delete: if signedIn() && userHasRole("admin");
    }
  }
}
